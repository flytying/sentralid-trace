# Copy to .env.local and fill in. Never commit real values.

# Meta Model API (the only AI provider this app calls at runtime).
# The app fails closed if the host or model below is changed to anything not on its allowlist.
META_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
MODEL_API_KEY=

# 32-byte key, base64-encoded, used to encrypt short-lived case tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CASE_SEAL_KEY=

# Optional tuning
MODEL_TIMEOUT_MS=45000
CASE_TTL_SECONDS=1800
